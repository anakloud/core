# Server Port
PORT=3001

# MongoDB Connection String (Required)
MONGO_URI=mongodb+srv://user:password@host/db_name

# Simple API Key for Inter-Service Auth (Generate using: openssl rand -hex 32)
API_KEY=your_generated_openssl_hex_32_key_here

# Resend Email Integration
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL="Anakloud <noreply@mail.anakloud.com>"

# Cloudflare R2 Storage Integration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=anakloud-storage
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
