{
  "name": "core-server",
  "module": "src/index.ts",
  "scripts": {
    "init:dev": "infisical login",
    "dev": "infisical run -- bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start:dist": "bun run dist/index.js",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@infisical/cli": "^0.43.97",
    "@types/bun": "latest",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.12.23",
    "mongoose": "^8.19.3",
    "reflect-metadata": "^0.2.2"
  }
}
