{
  "name": "core-server",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --preload ./src/patch.ts --hot src/index.ts",
    "start": "bun run --preload ./src/patch.ts src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start:dist": "bun run --preload ./src/patch.ts dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.9.3",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "graphql": "^16.14.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.23",
    "mongodb": "^7.5.0",
    "reflect-metadata": "^0.2.2"
  }
}
