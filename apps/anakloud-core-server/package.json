{
  "name": "anakloud-core-server",
  "module": "src/index.ts",
  "scripts": {
    "dev": "doppler run -- bun run --hot src/index.ts",
    "start": "doppler run -- bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start:dist": "doppler run -- bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "doppler run -- bunx drizzle-kit migrate",
    "db:push": "doppler run -- bunx drizzle-kit push",
    "db:studio": "doppler run -- bunx drizzle-kit studio",
    "db:run-migration": "doppler run -- bun run scripts/migrate.ts"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.9.3",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.23"
  }
}
