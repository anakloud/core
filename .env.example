DATABASE_URL=postgresql://user:password@host/db?sslmode=require&channel_binding=require
# JSON array of service API keys. PedConnect keys MUST be bound to a centreId.
SERVICE_KEYS=[{"key":"dev-teachday","service":"teachday"},{"key":"dev-pedconnect","service":"pedconnect","centreId":"00000000-0000-0000-0000-000000000000"},{"key":"dev-parentup","service":"parentup"},{"key":"dev-pedmd","service":"pedmd"}]
# JSON array of federated subgraphs the gateway composes.
SUBGRAPHS=[{"name":"core","url":"http://localhost:3000/graphql"}]
# Core server URL
EXPO_PUBLIC_API_URL=http://localhost:3000
# Dev-only full-read service key. Must match a pedmd-role entry in SERVICE_KEYS above.
# EXPO_PUBLIC_* vars are baked into the web bundle — never put a production key here.
EXPO_PUBLIC_SERVICE_KEY=dev-pedmd
