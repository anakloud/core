{
  "name": "core-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e apps/core-server/.env -- turbo run dev",
    "dev:server": "pnpm --filter core-server dev",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.8.14"
  },
  "packageManager": "pnpm@10.17.1"
}
