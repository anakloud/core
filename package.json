{
  "name": "core-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "init:dev": "pnpm --dir apps/core-server init:dev",
    "dev": "turbo run dev",
    "dev:server": "pnpm --dir apps/core-server dev",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.8.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@infisical/cli"
    ]
  },
  "packageManager": "pnpm@10.17.1"
}
